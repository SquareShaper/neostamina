{
	"schemaVersion": 1,
	"id": "neostamina",
	"version": "${version}",
	"name": "Neostamina",
	"description": "Stamina mod for the Neostalgia: Beta and Beyond modpack. Wholesale copied from Stamina Attributes :>",
	"authors": [
		"SquareShaper"
	],
	"contact": {
		"sources": "https://github.com/SquareShaper/neostamina"
	},
	"license": "MIT",
	"icon": "assets/neostamina/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.squareshaper.neostamina.Neostamina"
		],
		"client": [
			"net.squareshaper.neostamina.NeostaminaClient"
		]
	},
	"mixins": [
		"neostamina.mixins.json",
		{
			"config": "neostamina.client.mixins.json",
			"environment": "client"
		}
	],
	"custom": {
		"fzzy_config": [
			"neostamina"
		]
	},
	"depends": {
		"java": ">=21",
		"minecraft": "~${minecraft_version}",
		"fabricloader": ">=${loader_version}",
		"fabric-api": "*",
		"fzzy_config": ">=${fzzy_config_version}",
		"resourcebarapi": ">=${resource_bar_api_version}"
	}
}